# Copy to .env or provide environment variables. Never commit real secrets.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://schedule_app:CHANGE_ME@127.0.0.1:5432/schedule
PUBLIC_ORIGIN=https://schedule.example.org
APP_BASE_PATH=/
GUEST_MODE=1

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=250
REDIS_READ_TIMEOUT_MS=250
# Compose only. Set a local/deployment password before starting; never commit it.
POSTGRES_PASSWORD=CHANGE_ME
APP_PORT=8187

# Exact trusted reverse-proxy IPs, comma-separated; never '*' or broad CIDR.
# For host Nginx + Docker set the inspected frontend bridge gateway IP (see deploy/README.md).
FORWARDED_ALLOW_IPS=127.0.0.1
