[Unit]
Description=Clean expired Schedule demo workspaces
After=postgresql.service

[Service]
Type=oneshot
User=schedule
Group=schedule
WorkingDirectory=/opt/schedule/current
EnvironmentFile=/etc/schedule/schedule.env
ExecStart=/opt/schedule/current/.venv/bin/python -m app.cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
